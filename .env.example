# Contentful — Sikhs In The City
# Copy to .env (gitignored) and fill in. Tokens come from the Contentful web app.

# Management token (CFPAT-...). Used ONLY by the contentful/ migration + seed
# scripts. Never referenced by the running site — keep it out of Vercel runtime.
CONTENTFUL_TOKEN=

# Space coordinates.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master

# Read-only Content Delivery API token. The site uses this to fetch published
# content at runtime. Safe to expose to the server runtime (read-only).
CONTENTFUL_DELIVERY_TOKEN=

# Shared secret for the Contentful publish webhook -> /api/revalidate/contentful.
# Set the same value on the webhook in Contentful (Settings -> Webhooks).
CONTENTFUL_REVALIDATE_SECRET=
